{
  "info": {
    "name": "TrickLens",
    "description": "Local dev collection for the TrickLens API. The 'New User' folder creates a confirmed Cognito user and registers them (sign-up is credential-free; the confirm step uses Postman's AWS Signature auth — fill aws_access_key_id / aws_secret_access_key, the same keys `aws configure` uses, in the VARIABLES tab's Current Value column only so they don't sync). Everything else — logging in, the clip pipeline, follows, the feed — is one click per step, with each response's IDs auto-saved into the next request's variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{id_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "aws_region",
      "value": "us-east-1"
    },
    {
      "key": "cognito_client_id",
      "value": "",
      "description": "From .env — COGNITO_CLIENT_ID"
    },
    {
      "key": "cognito_user_pool_id",
      "value": "",
      "description": "From .env — COGNITO_USER_POOL_ID (only the 'New User' confirm step needs it)"
    },
    {
      "key": "aws_access_key_id",
      "value": "",
      "description": "Current Value only. Same key `aws configure` uses. Needed only for 'New User' -> Admin Confirm."
    },
    {
      "key": "aws_secret_access_key",
      "value": "",
      "description": "Current Value only — never Initial Value, which syncs to Postman's cloud."
    },
    {
      "key": "test_email",
      "value": "skater@example.com"
    },
    {
      "key": "test_password",
      "value": "Sk8-or-die1"
    },
    {
      "key": "username",
      "value": "nick",
      "description": "The app-side username to register"
    },
    {
      "key": "new_user_email",
      "value": "skater2@example.com"
    },
    {
      "key": "new_user_password",
      "value": "Sk8-or-die1"
    },
    {
      "key": "new_username",
      "value": "nick2",
      "description": "App-side username for the second user"
    },
    {
      "key": "follow_username",
      "value": "",
      "description": "Another registered username, for the follow requests (set to new_username's value)"
    },
    {
      "key": "id_token",
      "value": ""
    },
    {
      "key": "new_user_id_token",
      "value": ""
    },
    {
      "key": "clip_id",
      "value": ""
    },
    {
      "key": "upload_url",
      "value": ""
    },
    {
      "key": "feed_cursor",
      "value": ""
    },
    {
      "key": "comment_id",
      "value": ""
    },
    {
      "key": "comment_cursor",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Cognito)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-amz-json-1.1"
              },
              {
                "key": "X-Amz-Target",
                "value": "AWSCognitoIdentityProviderService.InitiateAuth"
              }
            ],
            "url": {
              "raw": "https://cognito-idp.{{aws_region}}.amazonaws.com/",
              "protocol": "https",
              "host": [
                "cognito-idp",
                "{{aws_region}}",
                "amazonaws",
                "com"
              ],
              "path": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"AuthFlow\": \"USER_PASSWORD_AUTH\",\n  \"ClientId\": \"{{cognito_client_id}}\",\n  \"AuthParameters\": {\n    \"USERNAME\": \"{{test_email}}\",\n    \"PASSWORD\": \"{{test_password}}\"\n  }\n}"
            },
            "description": "Unauthenticated Cognito action — no AWS credentials needed, just the (public) app client id. The user must already exist and be confirmed; this collection doesn't sign up or confirm users (those need either email verification or admin-confirm-sign-up, which requires real AWS credentials — see README)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.AuthenticationResult && data.AuthenticationResult.IdToken) {",
                  "    pm.collectionVariables.set('id_token', data.AuthenticationResult.IdToken);",
                  "    console.log('id_token saved to collection variables');",
                  "} else {",
                  "    console.warn('No IdToken in response — is the user signed up AND confirmed? See README Auth setup.', data);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "New User",
      "description": "Create + register a second (or third...) user. Set new_user_email / new_user_password / new_username first, then run 1-4 in order. Re-run with different values for more users.\n\nStep 2 needs AWS credentials (aws_access_key_id / aws_secret_access_key). If you'd rather not put them in Postman, skip step 2 and run this one line instead:\n  aws cognito-idp admin-confirm-sign-up --user-pool-id $COGNITO_USER_POOL_ID --username <new_user_email>",
      "item": [
        {
          "name": "1. Sign Up",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-amz-json-1.1"
              },
              {
                "key": "X-Amz-Target",
                "value": "AWSCognitoIdentityProviderService.SignUp"
              }
            ],
            "url": {
              "raw": "https://cognito-idp.{{aws_region}}.amazonaws.com/",
              "protocol": "https",
              "host": [
                "cognito-idp",
                "{{aws_region}}",
                "amazonaws",
                "com"
              ],
              "path": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ClientId\": \"{{cognito_client_id}}\",\n  \"Username\": \"{{new_user_email}}\",\n  \"Password\": \"{{new_user_password}}\",\n  \"UserAttributes\": [\n    { \"Name\": \"email\", \"Value\": \"{{new_user_email}}\" }\n  ]\n}"
            },
            "description": "Unauthenticated. Creates the Cognito user in UNCONFIRMED state. A UsernameExistsException here just means you already made this one — move on."
          }
        },
        {
          "name": "2. Admin Confirm (AWS creds)",
          "request": {
            "auth": {
              "type": "awsv4",
              "awsv4": [
                {
                  "key": "accessKey",
                  "value": "{{aws_access_key_id}}",
                  "type": "string"
                },
                {
                  "key": "secretKey",
                  "value": "{{aws_secret_access_key}}",
                  "type": "string"
                },
                {
                  "key": "region",
                  "value": "{{aws_region}}",
                  "type": "string"
                },
                {
                  "key": "service",
                  "value": "cognito-idp",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-amz-json-1.1"
              },
              {
                "key": "X-Amz-Target",
                "value": "AWSCognitoIdentityProviderService.AdminConfirmSignUp"
              }
            ],
            "url": {
              "raw": "https://cognito-idp.{{aws_region}}.amazonaws.com/",
              "protocol": "https",
              "host": [
                "cognito-idp",
                "{{aws_region}}",
                "amazonaws",
                "com"
              ],
              "path": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"UserPoolId\": \"{{cognito_user_pool_id}}\",\n  \"Username\": \"{{new_user_email}}\"\n}"
            },
            "description": "Confirms the user without the emailed code — the dev-pool bypass. Needs an IAM key with cognito-idp permissions (AmazonCognitoPowerUser). Returns an empty 200 on success."
          }
        },
        {
          "name": "3. Log In As New User",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-amz-json-1.1"
              },
              {
                "key": "X-Amz-Target",
                "value": "AWSCognitoIdentityProviderService.InitiateAuth"
              }
            ],
            "url": {
              "raw": "https://cognito-idp.{{aws_region}}.amazonaws.com/",
              "protocol": "https",
              "host": [
                "cognito-idp",
                "{{aws_region}}",
                "amazonaws",
                "com"
              ],
              "path": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"AuthFlow\": \"USER_PASSWORD_AUTH\",\n  \"ClientId\": \"{{cognito_client_id}}\",\n  \"AuthParameters\": {\n    \"USERNAME\": \"{{new_user_email}}\",\n    \"PASSWORD\": \"{{new_user_password}}\"\n  }\n}"
            },
            "description": "Saves the token to new_user_id_token — a separate variable, so your main id_token (from Auth -> Login) is untouched."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.AuthenticationResult && data.AuthenticationResult.IdToken) {",
                  "    pm.collectionVariables.set('new_user_id_token', data.AuthenticationResult.IdToken);",
                  "    console.log('new_user_id_token saved');",
                  "} else {",
                  "    console.warn('No IdToken — did step 2 (confirm) succeed?', data);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Register New User (POST /users)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{new_user_id_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{new_username}}\"\n}"
            },
            "description": "Uses new_user_id_token, not the collection's default token. After this, set follow_username to new_username's value and use the Social folder as your main user."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Register (POST /users)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\"\n}"
            },
            "description": "Only needed once per Cognito user — 409s if this login is already registered, which is fine to ignore."
          }
        },
        {
          "name": "Get Me (GET /users/me)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/users/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "me"
              ]
            }
          }
        },
        {
          "name": "Get Public Profile (GET /users/:username)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/users/{{follow_username}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "{{follow_username}}"
              ]
            },
            "description": "Public. Shows follower_count / following_count, and followed_by_me when called with a token."
          }
        }
      ]
    },
    {
      "name": "Social",
      "item": [
        {
          "name": "Follow User (POST /users/:username/follow)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/users/{{follow_username}}/follow",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "{{follow_username}}",
                "follow"
              ]
            },
            "description": "Set follow_username to another registered user first. 409 if already following, 422 if it's you."
          }
        },
        {
          "name": "Unfollow User (DELETE /users/:username/follow)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/users/{{follow_username}}/follow",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "{{follow_username}}",
                "follow"
              ]
            },
            "description": "Idempotent — 200 even if you weren't following."
          }
        },
        {
          "name": "Home Feed (GET /feed)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/feed?limit=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "feed"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "cursor",
                  "value": "{{feed_cursor}}",
                  "disabled": true
                }
              ]
            },
            "description": "Published clips from everyone you follow, newest first. Enable the cursor param (and it auto-fills from the last response) to page."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('feed_cursor', data.next_cursor || '');",
                  "console.log('items:', data.items.length, 'next_cursor:', data.next_cursor);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Engagement",
      "item": [
        {
          "name": "Like Clip (POST /clips/:clip_id/like)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/clips/{{clip_id}}/like",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "clips",
                "{{clip_id}}",
                "like"
              ]
            },
            "description": "Likes clip_id (set by the Clips folder). 201, or 409 if already liked / not published yet."
          }
        },
        {
          "name": "Unlike Clip (DELETE /clips/:clip_id/like)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/clips/{{clip_id}}/like",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "clips",
                "{{clip_id}}",
                "like"
              ]
            },
            "description": "Idempotent — 200 even if you hadn't liked it."
          }
        },
        {
          "name": "Add Comment (POST /clips/:clip_id/comments)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/clips/{{clip_id}}/comments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "clips",
                "{{clip_id}}",
                "comments"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"clean landing!\"\n}"
            },
            "description": "Top-level comment on clip_id. 409 if the clip isn't published yet."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('comment_id', data.id);",
                  "console.log('comment_id:', data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reply to Comment (POST /clips/:clip_id/comments)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/clips/{{clip_id}}/comments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "clips",
                "{{clip_id}}",
                "comments"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"for real\",\n  \"parent_id\": \"{{comment_id}}\"\n}"
            },
            "description": "Replies to comment_id (set by Add Comment). Threading is one level deep — 422 if comment_id is itself already a reply."
          }
        },
        {
          "name": "List Comments (GET /clips/:clip_id/comments)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/clips/{{clip_id}}/comments?limit=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "clips",
                "{{clip_id}}",
                "comments"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "cursor",
                  "value": "{{comment_cursor}}",
                  "disabled": true
                }
              ]
            },
            "description": "Top-level comments newest-first, with replies nested inline. Enable the cursor param (auto-filled from the last response) to page."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('comment_cursor', data.next_cursor || '');",
                  "console.log('items:', data.items.length, 'next_cursor:', data.next_cursor);"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Comment (DELETE /clips/:clip_id/comments/:comment_id)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/clips/{{clip_id}}/comments/{{comment_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "clips",
                "{{clip_id}}",
                "comments",
                "{{comment_id}}"
              ]
            },
            "description": "Deletable by its author or the clip's owner. 204 on success, 404 if already gone, 403 if you're neither."
          }
        }
      ]
    },
    {
      "name": "Clips",
      "item": [
        {
          "name": "1. Create Clip (POST /clips)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/clips",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "clips"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content_type\": \"video/mp4\",\n  \"duration_ms\": 5000,\n  \"source_fps\": 60\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('clip_id', data.clip.id);",
                  "pm.collectionVariables.set('upload_url', data.upload_url);",
                  "console.log('clip_id:', data.clip.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Upload to S3 (PUT presigned URL)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "video/mp4"
              }
            ],
            "url": "{{upload_url}}",
            "body": {
              "mode": "raw",
              "raw": "fake video bytes for testing — the stub analyzer never decodes this"
            },
            "description": "Uses upload_url saved by step 1 — run that request first. Not authenticated with the bearer token; presigned URLs carry their own auth in the query string."
          }
        },
        {
          "name": "3. Complete Upload (POST /clips/:clip_id/complete)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/clips/{{clip_id}}/complete",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "clips",
                "{{clip_id}}",
                "complete"
              ]
            }
          }
        },
        {
          "name": "4. Get Clip Status (GET /clips/:clip_id)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/clips/{{clip_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "clips",
                "{{clip_id}}"
              ]
            },
            "description": "Re-send this one to poll. status goes queued -> analyzing -> analyzed (or unanalyzable) once the worker picks it up — watch `docker compose logs -f worker` alongside this."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "console.log('status:', data.status);"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Tag Tricks (POST /clips/:clip_id/tricks)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/clips/{{clip_id}}/tricks",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "clips",
                "{{clip_id}}",
                "tricks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tricks\": [\"kickflip\"]\n}"
            },
            "description": "409s unless the clip's status is analyzed."
          }
        },
        {
          "name": "6. Publish (POST /clips/:clip_id/publish)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/clips/{{clip_id}}/publish",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "clips",
                "{{clip_id}}",
                "publish"
              ]
            },
            "description": "422s if no trick has been tagged yet — try this before step 5 once, on a fresh clip, to see that guard fire."
          }
        }
      ]
    }
  ]
}
