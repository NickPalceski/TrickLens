# Copy to .env for local development:  cp .env.example .env
# Every value here is a local-only dummy. Nothing secret belongs in this file.

ENV=dev

# --- Database -------------------------------------------------------------
# The app runs async (asyncpg); Alembic runs sync (psycopg). Same database,
# two drivers. This surprises people — it is not a mistake.
DATABASE_URL=postgresql+asyncpg://tricklens:tricklens@postgres:5432/tricklens
ALEMBIC_DATABASE_URL=postgresql+psycopg://tricklens:tricklens@postgres:5432/tricklens

# --- AWS ------------------------------------------------------------------
# AWS_ENDPOINT_URL points boto3 at LocalStack. In production this is EMPTY,
# which makes boto3 talk to real AWS. That single variable is the entire
# local <-> cloud seam.
AWS_ENDPOINT_URL=http://localstack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Presigned S3 URLs are signed against AWS_ENDPOINT_URL above (the
# Docker-network hostname) but handed to clients outside the compose
# network (curl, Postman, a browser) — this swaps the host on the way out
# so those URLs are actually reachable.
AWS_PUBLIC_ENDPOINT_URL=http://localhost:4566

S3_BUCKET=tricklens-media
SQS_ANALYSIS_QUEUE_URL=http://localstack:4566/000000000000/tricklens-analysis

# In production this becomes the CloudFront domain.
CDN_BASE_URL=http://localhost:4566/tricklens-media

# --- API ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- Cognito ----------------------------------------------------------------
# Always the real service, dev included — see docs/ARCHITECTURE.md. Run
# scripts/cognito-bootstrap.sh once and paste its output here.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
